{
  "manifest_version": 3,
  "name": "Read Free",
  "version": "0.26.4",
  "description": "Takes paywalls off news articles (NYT, FT, The Atlantic, CNN and more), filling in cut text from archive.today.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Read Free",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://archive.ph/*",
    "https://archive.is/*",
    "https://archive.today/*",
    "https://archive.md/*",
    "https://archive.li/*",
    "https://archive.vn/*",
    "https://archive.fo/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/*",
        "https://cooking.nytimes.com/*"
      ],
      "js": [
        "src/archive.js",
        "src/extract.js",
        "src/render.js",
        "src/status.js",
        "src/paywall.js",
        "src/notices.js",
        "src/cache.js",
        "src/scroll.js",
        "src/settings.js",
        "src/adapter.js",
        "sites/nyt.js",
        "src/reasons.js",
        "src/tally.js",
        "src/notify.js",
        "src/details.js",
        "src/content.js"
      ],
      "css": [
        "content.css",
        "sites/nyt.css"
      ],
      "run_at": "document_idle"
    },
